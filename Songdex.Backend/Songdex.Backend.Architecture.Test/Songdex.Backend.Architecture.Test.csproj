<Project Sdk="Microsoft.NET.Sdk">

    <!--
      Guards the architecture rules from docs/architecture.md.
      Deliberately references ALL production projects — only then does ArchUnitNET see every assembly.
      This project is not part of the production dependency graph.
    -->

    <PropertyGroup>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="coverlet.collector"/>
        <PackageReference Include="Microsoft.NET.Test.Sdk"/>
        <PackageReference Include="xunit"/>
        <PackageReference Include="xunit.runner.visualstudio"/>
        <PackageReference Include="TngTech.ArchUnitNET.xUnit"/>
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Songdex.Backend.Common\Songdex.Backend.Common.csproj" />
        <ProjectReference Include="..\Songdex.Backend.Application\Songdex.Backend.Application.csproj" />
        <ProjectReference Include="..\Songdex.Backend.Adapter.In.Web\Songdex.Backend.Adapter.In.Web.csproj" />
        <ProjectReference Include="..\Songdex.Backend.Adapter.Out.Persistence\Songdex.Backend.Adapter.Out.Persistence.csproj" />
        <ProjectReference Include="..\Songdex.Backend.Main\Songdex.Backend.Main.csproj" />
    </ItemGroup>

</Project>
